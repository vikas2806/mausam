# Mausam Application Environment Variables

# Application
VITE_APP_TITLE=Mausam - Weather App
VITE_ENABLE_MOCK_DATA=true
VITE_DEFAULT_LOCATION=noida-01

# Language
VITE_DEFAULT_LANGUAGE=en

# Weather Provider Configuration
# Set VITE_USE_REAL_WEATHER=true to enable live API data; false for mock data
VITE_USE_REAL_WEATHER=true
# Provider choice: 'openweather' (OpenWeatherMap) or 'open-meteo' (Open-Meteo)
VITE_WEATHER_PROVIDER=openweather

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

